# Submit analysis source and dependency declarations only.
/*
!/.gitignore
!/README.md
!/[0-9][0-9]_*.sh
!/code/
/code/**
!/code/**/
!/code/**/*.R
!/code/**/*.r
!/code/**/*.py
!/code/**/*.sh
!/code/**/*.patch
!/code/requirements/*.txt
/code/references/
# Required third-party runtime sources; other upstream files stay local.
/code/vendor/*
!/code/vendor/PIDC/
/code/vendor/PIDC/*
!/code/vendor/PIDC/PIDC.R
!/code/vendor/SCODE/
/code/vendor/SCODE/*
!/code/vendor/SCODE/SCODE.R
!/code/vendor/SCODE/README.md
!/code/vendor/SINCERITIES/
/code/vendor/SINCERITIES/*
!/code/vendor/SINCERITIES/cmtest2.R
!/code/vendor/SINCERITIES/final_ranked_predictions.R
!/code/vendor/SCSGL/
/code/vendor/SCSGL/*
!/code/vendor/SCSGL/LICENSE
!/code/vendor/SCSGL/run_scSGL.py
!/code/vendor/SCSGL/pysrc/
!/code/vendor/SCSGL/pysrc/**/
!/code/vendor/SCSGL/pysrc/**/*.py
/code/vendor/SCSGL/pysrc/evaluation/

